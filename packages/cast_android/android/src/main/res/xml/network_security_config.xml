<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is used only for the local-LAN signaling WebSocket.
     The sender accepts private RFC1918 IPv4 targets only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
